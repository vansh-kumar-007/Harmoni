# Harmoni Environment Configuration Template
# BUDGET NOTICE: Harmoni requires ₹0 INR expenditure.
# All services and configurations below must use free, non-commercial tiers.
# NEVER commit actual secrets or credentials to version control.

# Database Connection (PostgreSQL)
# Local: postgresql://postgres:password@localhost:5432/harmoni
# Cloud: Neon Serverless PostgreSQL free connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/harmoni"

# Authentication & Session Security (Generate with: openssl rand -base64 32)
SESSION_SECRET="your-32-character-random-session-secret-here"

# Music APIs (Free developer registration, no payment method required)
# Jamendo API (v3.0): https://developer.jamendo.com/
JAMENDO_CLIENT_ID="your_free_jamendo_client_id_here"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
