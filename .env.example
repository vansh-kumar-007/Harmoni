# =============================================================================
# Harmoni Environment Configuration Template
# BUDGET NOTICE: Harmoni requires strictly ₹0 INR expenditure.
# All services and configurations below must use free, non-commercial tiers.
# NEVER commit actual secrets, passwords, or tokens to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# Local Development (Windows PostgreSQL 18.x on port 5432):
# Format: postgresql://<user>:<password>@localhost:5432/<dbname>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/harmoni"

# Future Online Deployment (Neon Serverless PostgreSQL Free Tier):
# Format: postgresql://<user>:<password>@<ep-pooler-id>.neon.tech/harmoni?sslmode=require
# DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/harmoni?sslmode=require"

# Note: Neither local PostgreSQL nor cloud credentials are required to run
# Prisma schema validation (`pnpm db:validate`) or client generation (`pnpm db:generate`).

# -----------------------------------------------------------------------------
# Authentication & Session Security (Milestone 3+)
# -----------------------------------------------------------------------------
# Cryptographically secure random 32+ character string (generate: openssl rand -base64 32)
SESSION_SECRET="your-32-character-random-session-secret-here"

# -----------------------------------------------------------------------------
# Music Discovery & Playback APIs (Milestone 4+)
# -----------------------------------------------------------------------------
# Free developer registration without payment methods: https://developer.jamendo.com/
JAMENDO_CLIENT_ID="your_free_jamendo_client_id_here"

# -----------------------------------------------------------------------------
# Application Origin
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
